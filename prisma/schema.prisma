generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  PARTICIPANT
}

enum TextDirection {
  RTL
  LTR
}

enum SpeedScoringMode {
  BONUS_POINTS
  TIE_BREAKER
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  TIME_UP
}

enum RegistrationMode {
  SIMULASI
  CHAMPION
}

enum RegistrationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum OptionContentType {
  TEXT
  AUDIO
}

model User {
  id           String        @id @default(cuid())
  username     String        @unique
  name         String
  passwordHash String
  role         Role          @default(PARTICIPANT)
  institution  String?
  phone        String?
  email        String?       @unique
  whatsapp     String?       @unique
  isActive     Boolean       @default(true)
  attempts     ExamAttempt[]
  toaflAttempts Attempt[]
  registrations Registration[]
  emailLogs    EmailLog[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

enum EmailStatus {
  SENT
  FAILED
}

// TOAFL Fase 1: pendaftaran peserta per mode + level. Simulasi dibuat
// langsung VERIFIED; Champion PENDING sampai admin memverifikasi.
model Registration {
  id              String             @id @default(cuid())
  userId          String
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  mode            RegistrationMode
  levelId         String
  level           Level              @relation(fields: [levelId], references: [id], onDelete: Cascade)
  status          RegistrationStatus @default(PENDING)
  paymentProofUrl String?
  verifiedBy      String?
  verifiedAt      DateTime?
  rejectionReason String?            @db.Text
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@unique([userId, mode, levelId])
}

model EmailLog {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    EmailStatus
  resendId  String?
  error     String?     @db.Text
  createdAt DateTime    @default(now())
}

model QuestionCategory {
  id          String     @id @default(cuid())
  name        String
  description String?
  questions   Question[]
  createdAt   DateTime   @default(now())
}

// TOAFL Fase 1: level ujian (dinamis, diatur admin). Bank soal milik level.
model Level {
  id            String         @id @default(cuid())
  name          String         @unique
  description   String?
  order         Int            @default(0)
  isActive      Boolean        @default(true)
  questions     Question[]
  registrations Registration[]
  exams         Exam[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

// TOAFL Fase 1: maharoh ujian (dinamis, diatur admin).
model Maharoh {
  id                  String     @id @default(cuid())
  name                String     @unique
  description         String?
  order               Int        @default(0)
  defaultMinutes      Int        @default(45)
  defaultAudioRepeats Int        @default(2)
  isActive            Boolean    @default(true)
  questions           Question[]
  examMaharohs        ExamMaharoh[]
  sectionAttempts     SectionAttempt[]
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
}

// TOAFL Fase 5: pelanggaran yang terdeteksi klien selama ujian.
// TAB_CLOSE = tab ditutup/pindah (visibilitychange hidden, pagehide);
// BLUR = jendela kehilangan fokus; FLOATING_APP = aplikasi mengambang
// (belum ada deteksi browser yang andal — tipe disediakan untuk
// pelaporan server/manual di masa depan, klien saat ini tidak
// mengirimkannya). Simulasi: memicu auto-submit maharoh berjalan.
// Champion: hanya dicatat.
enum ViolationType {
  TAB_CLOSE
  FLOATING_APP
  BLUR
}

model ViolationEvent {
  id        String        @id @default(cuid())
  attemptId String
  attempt   Attempt       @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  type      ViolationType
  at        DateTime      @default(now())
  detail    String?

  @@index([attemptId, at])
}

// TOAFL Fase 4: attempt ujian TOAFL (mesin baru). Satu attempt milik satu
// Exam (mode SIMULASI/CHAMPION). Champion sekali saja + simulasi boleh
// diulang: aturan itu ditegakkan di API start (bukan @@unique), karena satu
// constraint DB tidak bisa bersyarat per mode.
model Attempt {
  id               String        @id @default(cuid())
  userId           String
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  examId           String
  exam             Exam          @relation(fields: [examId], references: [id], onDelete: Cascade)
  status           AttemptStatus @default(IN_PROGRESS)
  startedAt        DateTime      @default(now())
  finishedAt       DateTime?
  timeSpentSeconds Int?
  rawScore         Float         @default(0)
  finalScore       Float         @default(0)
  // Peta maharohId -> urutan ID soal yang diacak untuk attempt ini.
  questionOrder    Json?
  currentMaharohId String?
  sections         SectionAttempt[]
  answers          AttemptAnswer[]
  violations       ViolationEvent[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

// TOAFL Fase 4: satu maharoh dalam satu attempt. Snapshot membekukan soal +
// urutan opsi + kunci + bobot saat maharoh dimulai (§8 plan) — jawaban dan
// penilaian merujuk snapshot, bukan bank live.
model SectionAttempt {
  id         String        @id @default(cuid())
  attemptId  String
  attempt    Attempt       @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  maharohId  String
  maharoh    Maharoh       @relation(fields: [maharohId], references: [id], onDelete: Cascade)
  status     AttemptStatus @default(IN_PROGRESS)
  startedAt  DateTime      @default(now())
  expiresAt  DateTime
  finishedAt DateTime?
  score      Float         @default(0)
  snapshot   Json
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@unique([attemptId, maharohId])
}

// TOAFL Fase 4: jawaban peserta per soal. audioPlayCount dihitung server
// (satu counter per soal: audio soal + audio opsi soal itu berbagi batas
// pengulangan maharoh). questionId/selectedOptionId disimpan sebagai String
// tanpa relasi Prisma — penilaian memakai snapshot yang dibekukan, bukan
// baris bank live.
model AttemptAnswer {
  id               String   @id @default(cuid())
  attemptId        String
  attempt          Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId       String
  maharohId        String
  selectedOptionId String?
  isDoubtful       Boolean  @default(false)
  answeredAt       DateTime @default(now())
  audioPlayCount   Int      @default(0)

  @@unique([attemptId, questionId])
}

// TOAFL Fase 2: ujian per mode + level. Waktu, jumlah soal, dan batas
// audio diatur PER MAHAROH di ExamMaharoh — bukan satu durasi global
// seperti ExamSession Olimpiade. Jadwal (startTime/endTime) hanya berlaku
// untuk CHAMPION; SIMULASI null = kapan saja.
model Exam {
  id                    String        @id @default(cuid())
  mode                  RegistrationMode
  levelId               String
  level                 Level         @relation(fields: [levelId], references: [id], onDelete: Cascade)
  title                 String
  description           String?       @db.Text
  isActive              Boolean       @default(false)
  startTime             DateTime?
  endTime               DateTime?
  autoSubmitOnViolation Boolean       @default(true)
  maharohs              ExamMaharoh[]
  attempts              Attempt[]
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
}

model ExamMaharoh {
  id           String  @id @default(cuid())
  examId       String
  exam         Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  maharohId    String
  maharoh      Maharoh @relation(fields: [maharohId], references: [id], onDelete: Cascade)
  orderIndex   Int     @default(0)
  minutes      Int
  audioRepeats Int     @default(2)
  questionCount Int

  @@unique([examId, maharohId])
}

model Question {
  id          String            @id @default(cuid())
  categoryId  String?
  category    QuestionCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  levelId     String?
  level       Level?            @relation(fields: [levelId], references: [id], onDelete: SetNull)
  maharohId   String?
  maharoh     Maharoh?          @relation(fields: [maharohId], references: [id], onDelete: SetNull)
  audioUrl    String?
  content     String            @db.Text
  direction   TextDirection     @default(RTL)
  weight      Float             @default(4.0)
  explanation String?           @db.Text
  options     QuestionOption[]
  sessions    SessionQuestion[]
  answers     LegacyAttemptAnswer[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model QuestionOption {
  id         String          @id @default(cuid())
  questionId String
  question   Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  label      String
  content    String          @db.Text
  direction  TextDirection   @default(RTL)
  isCorrect  Boolean         @default(false)
  contentType OptionContentType @default(TEXT)
  audioUrl   String?
  answers    LegacyAttemptAnswer[]
}

model ExamSession {
  id               String            @id @default(cuid())
  title            String
  description      String?           @db.Text
  rulesContent     String            @db.Text
  accessToken      String            @unique
  durationMinutes  Int               @default(60)
  isActive         Boolean           @default(false)
  // EMBARGO HASIL (5 Nov 2026): false = nilai & peringkat attempt selesai
  // ditahan dari peserta (API + tampilan); true = ditampilkan. Admin
  // membukanya lewat toggle di halaman sesi saat pengumuman resmi.
  resultsVisible   Boolean           @default(false)
  startTime        DateTime?
  endTime          DateTime?
  shuffleQuestions Boolean           @default(true)
  shuffleOptions   Boolean           @default(false)
  wrongPenalty     Float             @default(0.0)
  speedScoringMode SpeedScoringMode  @default(BONUS_POINTS)
  maxSpeedBonus    Float             @default(20.0)
  questions        SessionQuestion[]
  attempts         ExamAttempt[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model SessionQuestion {
  id         String      @id @default(cuid())
  sessionId  String
  session    ExamSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionId String
  question   Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  orderIndex Int         @default(0)

  @@unique([sessionId, questionId])
}

model ExamAttempt {
  id               String          @id @default(cuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId        String
  session          ExamSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  status           AttemptStatus   @default(IN_PROGRESS)
  tokenVerifiedAt  DateTime        @default(now())
  startedAt        DateTime?
  expiresAt        DateTime?
  // Sinyal aktivitas terakhir peserta selama mengerjakan (heartbeat
  // 30 detik dari halaman ujian + setiap simpan jawaban). Dipakai
  // monitoring untuk membedakan "masih online" dari "browser ditutup".
  lastSeenAt       DateTime?
  extraMinutes     Int             @default(0)
  finishedAt       DateTime?
  timeSpentSeconds Int?
  rawScore         Float           @default(0)
  penaltyScore     Float           @default(0)
  speedBonus       Float           @default(0)
  finalScore       Float           @default(0)
  questionOrder    Json?
  answers          LegacyAttemptAnswer[]
  updatedAt        DateTime        @updatedAt

  @@unique([userId, sessionId])
}

// Jawaban model Olimpiade lama (ExamAttempt/ExamSession). Namanya diganti
// supaya nama AttemptAnswer bisa dipakai mesin TOAFL Fase 4; nama field
// relasi (answers) TIDAK berubah sehingga scoring.ts + monitoring lama
// tetap jalan tanpa edit.
model LegacyAttemptAnswer {
  id               String          @id @default(cuid())
  attemptId        String
  attempt          ExamAttempt     @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId       String
  question         Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOptionId String?
  selectedOption   QuestionOption? @relation(fields: [selectedOptionId], references: [id], onDelete: SetNull)
  isDoubtful       Boolean         @default(false)
  answeredAt       DateTime        @default(now())

  @@unique([attemptId, questionId])
}


